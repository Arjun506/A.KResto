  updatedAt        DateTime @updatedAt

  room             hotel_rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("hotel_maintenance_records")
}

model hotel_digital_keys {
  id         String   @id @default(cuid())
  bookingId  String
