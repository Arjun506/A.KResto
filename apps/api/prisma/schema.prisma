model hotel_properties {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  address     String?
  starRating  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms       hotel_rooms[]
  roomTypes   hotel_room_types[]
  bookings    hotel_bookings[]

  @@index([tenantId])
  @@map("hotel_properties")
}

model hotel_room_types {
  id           String   @id @default(cuid())
  tenantId     String?
  propertyId   String
  name         String
  basePrice    Float    @default(0)
  maxOccupants Int      @default(2)
  amenities    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     hotel_properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms        hotel_rooms[]

  @@index([tenantId])
  @@index([propertyId])
  @@map("hotel_room_types")
}

model hotel_rooms {
  id           String   @id @default(cuid())
  tenantId     String?
  propertyId   String
  roomNumber   String
  roomTypeId   String
  status       String   @default("CLEAN") // CLEAN, DIRTY, INSPECTION, MAINTENANCE
  isOccupied   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     hotel_properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType     hotel_room_types @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  bookings     hotel_bookings[]
  housekeepingTasks hotel_housekeeping_tasks[]
  maintenanceRecords hotel_maintenance_records[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@map("hotel_rooms")
}

model hotel_bookings {
  id               String   @id @default(cuid())
  tenantId         String?
  propertyId       String
  roomId           String
  customerId       String?
  checkInDateTime  DateTime
  checkOutDateTime DateTime
  status           String   @default("CONFIRMED") // CONFIRMED, CHECKED_IN, CHECKED_OUT, CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property         hotel_properties @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room             hotel_rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)
  customer         customers? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  digitalKeys      hotel_digital_keys[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([roomId])
  @@index([customerId])
  @@map("hotel_bookings")
}

model hotel_housekeeping_tasks {
  id                 String   @id @default(cuid())
  roomId             String
  assignedEmployeeId String?
  status             String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  room               hotel_rooms @relation(fields: [roomId], references: [id], onDelete: Cascade)
  employee           employees?  @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([assignedEmployeeId])
  @@map("hotel_housekeeping_tasks")
}

model hotel_maintenance_records {
  id               String   @id @default(cuid())
  roomId           String
