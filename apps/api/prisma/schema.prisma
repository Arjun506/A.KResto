  status     String   @default("ACTIVE") // ACTIVE, EXPIRED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking    hotel_bookings @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("hotel_digital_keys")
}

