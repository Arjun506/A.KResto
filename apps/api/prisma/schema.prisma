}

model logistics_cod_collections {
  id                   String   @id @default(cuid())
  shipmentId           String
  expectedAmount       Float
  driverCollectedAmount Float    @default(0)
  settlementStatus     String   @default("PENDING") // PENDING, RECONCILED, FAILED
  paymentTxRef         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shipment             logistics_shipments @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("logistics_cod_collections")
}

model logistics_returns {
  id          String   @id @default(cuid())
  tenantId    String?
  shipmentId  String
  orderId     String
  status      String   @default("RETURN_REQUESTED") // RETURN_REQUESTED, RETURN_PICKUP_SCHEDULED, RETURN_PICKED_UP, RETURNED, RETURN_COMPLETED
  reason      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipment    logistics_shipments @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  order       orders @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([shipmentId])
  @@index([orderId])
  @@map("logistics_returns")
}

model logistics_maintenance_records {
  id               String   @id @default(cuid())
  vehicleId        String
  description      String
  cost             Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicle          logistics_vehicles @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("logistics_maintenance_records")
}

model security_key_metadata {
  id           String   @id @default(cuid())
  tenantId     String?
  keyId        String   @unique
  wrappedDek   String
  keyVersion   Int      @default(1)
  algorithm    String   @default("AES-256-GCM")
  status       String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("security_key_metadata")
}

model security_access_events {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  resourceType String
  resourceId   String?
  action       String   // security.data.viewed, security.data.decrypted, etc.
  purpose      String?
  requestId    String?
  sessionId    String?
  createdAt    DateTime @default(now())

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("security_access_events")
}

model security_mfa_challenges {
  id           String   @id @default(cuid())
  userId       String
  challengeId  String   @unique
  codeHash     String
  purpose      String
  expiresAt    DateTime
  verifiedAt   DateTime?
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("security_mfa_challenges")
}

model kitchen_stations {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  code         String
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("kitchen_stations")
}

model kitchen_tickets {
  id              String                 @id @default(cuid())
  tenantId        String
  orderId         String
  stationCode     String                 @default("MAIN_KITCHEN")
  status          String                 @default("PENDING")
  priority        String                 @default("NORMAL")
  notes           String?
  prepStartedAt   DateTime?
  prepCompletedAt DateTime?
  servedAt        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  orders          orders                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket_items    kitchen_ticket_items[]

  @@unique([orderId, stationCode])
  @@index([tenantId])
  @@index([orderId])
  @@index([stationCode])
  @@index([status])
  @@map("kitchen_tickets")
}

model kitchen_ticket_items {
  id          String          @id @default(cuid())
  ticketId    String
  orderItemId String
  menuItemId  String
  name        String
  quantity    Int
  notes       String?
  createdAt   DateTime        @default(now())
  ticket      kitchen_tickets @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_ticket_items")
}













