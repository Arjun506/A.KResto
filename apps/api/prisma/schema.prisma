model logistics_hubs {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shipmentsOrigin logistics_shipments[] @relation("OriginHub")
  shipmentsDest   logistics_shipments[] @relation("DestHub")

  @@index([tenantId])
  @@map("logistics_hubs")
}

model logistics_vehicles {
  id           String   @id @default(cuid())
  tenantId     String?
  licensePlate String   @unique
  makeModel    String
  capacityKg   Float    @default(0)
  status       String   @default("ACTIVE") // ACTIVE, MAINTENANCE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driverAssignments logistics_driver_assignments[]
  routes       logistics_routes[]
  maintenanceRecords logistics_maintenance_records[]

  @@index([tenantId])
  @@map("logistics_vehicles")
}

model logistics_driver_assignments {
  id               String   @id @default(cuid())
  vehicleId        String
  driverEmployeeId String
  assignedAt       DateTime @default(now())
  releasedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  vehicle          logistics_vehicles @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver           employees @relation(fields: [driverEmployeeId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([driverEmployeeId])
  @@map("logistics_driver_assignments")
}

model logistics_shipments {
  id               String   @id @default(cuid())
  tenantId         String?
  orderId          String
  originHubId      String?
  destinationHubId String?
  status           String   @default("CREATED") 
  // CREATED, PICKUP_SCHEDULED, PICKED_UP, AT_ORIGIN_HUB, IN_TRANSIT, AT_DESTINATION_HUB, OUT_FOR_DELIVERY, DELIVERED
  // FAILED_DELIVERY, DELIVERY_RESCHEDULED, RETURN_INITIATED, RETURN_IN_TRANSIT, RETURNED, CANCELLED, LOST, DAMAGED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order            orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  originHub        logistics_hubs? @relation("OriginHub", fields: [originHubId], references: [id], onDelete: SetNull)
  destinationHub   logistics_hubs? @relation("DestHub", fields: [destinationHubId], references: [id], onDelete: SetNull)
  packages         logistics_packages[]
  dispatches       logistics_dispatches[]
  routeStops       logistics_route_stops[]
  trackingEvents   logistics_tracking_events[]
  proofOfDeliveries logistics_proof_of_delivery[]
  codCollections   logistics_cod_collections[]
  returns          logistics_returns[]

  @@index([tenantId])
  @@index([orderId])
  @@index([originHubId])
  @@index([destinationHubId])
  @@map("logistics_shipments")
}

model logistics_packages {
  id          String   @id @default(cuid())
  shipmentId  String
  weightKg    Float
  lengthCm    Float
  widthCm     Float
  heightCm    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipment    logistics_shipments @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("logistics_packages")
}

model logistics_dispatches {
  id               String   @id @default(cuid())
  shipmentId       String
  driverEmployeeId String?
  vehicleId        String?
  status           String   @default("PENDING") // PENDING, DISPATCHED, CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shipment         logistics_shipments @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("logistics_dispatches")
}

model logistics_routes {
  id               String   @id @default(cuid())
  tenantId         String?
  vehicleId        String
