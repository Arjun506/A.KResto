generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  location              String?
  email                 String?
  phone                 String?
  address               String?
  timezone              String                  @default("UTC")
  currency              String                  @default("USD")
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?
  logo                  String?
  industry              String                  @default("RESTAURANT")
  settings              Json?
  language              String                  @default("en")
  status                TenantStatus            @default(ACTIVE)
  branding              Json?
  customDomains         String[]                @default([])
  limits                Json?
  metadata              Json?
  organizations         organizations[]
  businesses            businesses[]
  customers             customers[]
  products              products[]
  priceBooks            price_books[]
  warehouses            warehouses[]
  inventoryMasterItems  inventory_master_items[]
  transactions          transactions_registry[]
  universalOrders       universal_orders[]
  paymentTransactions   payment_transactions[]
  paymentSettlements     payment_settlements[]
  giftCards             gift_cards[]
  paymentReconciliations payment_reconciliations[]
  paymentIntents        payment_intents[]
  workflowDefinitions   workflow_definitions[]
  workflowInstances     workflow_instances[]
  workflowApprovals     workflow_approvals[]
  workflowTasks         workflow_tasks[]
  workflowSlas          workflow_slas[]
  workflowWebhooks      workflow_webhooks[]
  crmLeads              crm_leads[]
  crmOpportunities      crm_opportunities[]
  crmCases              crm_cases[]
  crmInteractions       crm_interactions[]
  crmTickets            crm_tickets[]
  crmFeedbacks          crm_feedbacks[]
  crmRelationships      crm_relationships[]
  restTables            rest_tables[]
  restReservations      rest_reservations[]
  restKitchenTickets    rest_kitchen_tickets[]
  kitchenStations       kitchen_stations[]
  kitchenTickets        kitchen_tickets[]
  restShifts            rest_shifts[]
  platformPackConfigs   platform_pack_configs[]
  platformPackInstallations platform_pack_installations[]
  custFavorites         cust_favorites[]
  custReviews           cust_reviews[]
  custCarts             cust_carts[]
  consoleDashboards     console_dashboards[]
  consoleWidgets        console_widgets[]
  consolePinnedNav      console_pinned_nav[]
  consoleSavedViews     console_saved_views[]
  consoleWorkspaces     console_workspaces[]
  aiPrompts             ai_prompts[]
  aiAgents              ai_agents[]
  aiAgentRuns           ai_agent_runs[]
  aiMemories            ai_memories[]
  aiConversations       ai_conversations[]
  aiUsageMetrics        ai_usage_metrics[]
  aiGuardrails          ai_guardrails[]
  aiSkills              ai_skills[]
  aiTools               ai_tools[]
  hotelProperties       hotel_properties[]
  hotelRooms            hotel_rooms[]
  hotelRoomTypes        hotel_room_types[]
  hotelBookings         hotel_bookings[]
  retailStores          retail_stores[]
  retailStockBatches    retail_stock_batches[]
  retailPromotions      retail_promotions[]
  retailPurchaseOrders  retail_purchase_orders[]
  retailSuppliers       retail_suppliers[]
  retailReturns         retail_returns[]
  hcFacilities          hc_facilities[]
  hcPatientProfiles     hc_patient_profiles[]
  hcAppointments        hc_appointments[]
  logisticsHubs         logistics_hubs[]
  logisticsVehicles     logistics_vehicles[]
  logisticsShipments    logistics_shipments[]
  logisticsRoutes       logistics_routes[]
  logisticsReturns      logistics_returns[]
  auditLogs             audit_logs[]
  securityKeyMetadata   security_key_metadata[]
  securityAccessEvents  security_access_events[]
  branches              branch[]
  categories            categories[]
  employees             employees[]
  inventory_items       inventory_items[]
  inventory_movements   inventory_movements[]
  menu_item_addons      menu_item_addons[]
  menu_item_ingredients menu_item_ingredients[]
  menu_item_variants    menu_item_variants[]
  menu_items            menu_items[]
  orders                orders[]
  purchase_orders       purchase_orders[]
  reservations          reservations[]
  roles_permissions     roles_permissions[]
  subscriptions         subscriptions[]
  suppliers             suppliers[]
  tables                tables[]
  tenant_features       tenant_features[]
  users                 users[]

  @@map("tenants")
}

model organizations {
  id          String       @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  description String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businesses  businesses[]

  @@index([tenantId])
  @@map("organizations")
}

model businesses {
  id             String         @id @default(cuid())
  tenantId       String?
  organizationId String
  name           String
  legalName      String?
  displayName    String?
  code           String?
  description    String?
  industry       String?
  status         BusinessStatus @default(PENDING_VERIFICATION)
  isVerified     Boolean        @default(false)
  branding       Json?
  socialLinks    Json?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  organization   organizations  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  divisions      divisions[]

  ownerships     business_ownership[]
  outgoingRelations business_relationships[] @relation("SourceBusiness")
  incomingRelations business_relationships[] @relation("TargetBusiness")
  settings       business_settings?
  categoryMappings business_category_mapping[]
  contacts       business_contacts[]
  addresses      business_addresses[]
  tagMappings    business_tag_mapping[]
  attachments    business_attachments[]
  notes          business_notes[]
  timeline       business_timeline[]
  customers      customers[]
  products       products[]
  productSuppliers product_suppliers[]
  warehouses     warehouses[]
  transactions   transactions_registry[]
  universalOrders universal_orders[]
  paymentTransactions payment_transactions[]
  paymentSettlements payment_settlements[]
  crmLeads           crm_leads[]

  @@index([organizationId])
  @@index([tenantId])
  @@index([status])
  @@map("businesses")
}

model business_ownership {
  id          String        @id @default(cuid())
  businessId  String
  userId      String
  role        OwnershipRole @default(OWNER)
  percentage  Float?
  isCurrent   Boolean       @default(true)
  assignedAt  DateTime      @default(now())
  unassignedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    businesses    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@map("business_ownership")
}

model business_relationships {
  id               String           @id @default(cuid())
  sourceBusinessId String
  targetBusinessId String
  type             RelationshipType
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  sourceBusiness   businesses       @relation("SourceBusiness", fields: [sourceBusinessId], references: [id], onDelete: Cascade)
  targetBusiness   businesses       @relation("TargetBusiness", fields: [targetBusinessId], references: [id], onDelete: Cascade)

  @@index([sourceBusinessId])
  @@index([targetBusinessId])
  @@map("business_relationships")
}

model business_settings {
  id                  String     @id @default(cuid())
  businessId          String     @unique
  locale              String     @default("en-US")
  currency            String     @default("USD")
  timezone            String     @default("UTC")
  language            String     @default("en")
  fiscalYearStart     String     @default("01-01")
  workingHours        Json?
  regionalPreferences Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  business            businesses @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model business_categories {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  mappings    business_category_mapping[]

  @@map("business_categories")
}

model business_category_mapping {
  id         String              @id @default(cuid())
  businessId String
  categoryId String
  createdAt  DateTime            @default(now())
  business   businesses          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category   business_categories @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([businessId, categoryId])
  @@map("business_category_mapping")
}

model business_contacts {
  id         String      @id @default(cuid())
  businessId String
  type       ContactType @default(PRIMARY)
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean     @default(false)
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  business   businesses  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_contacts")
}

model business_addresses {
  id         String      @id @default(cuid())
  businessId String
  type       AddressType @default(HEAD_OFFICE)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  latitude   Float?
  longitude  Float?
  timezone   String      @default("UTC")
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  business   businesses  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_addresses")
}

model business_tags {
  id        String                 @id @default(cuid())
  tenantId  String?
  name      String                 @unique
  color     String?
  createdAt DateTime               @default(now())
  mappings  business_tag_mapping[]

  @@map("business_tags")
}

model business_tag_mapping {
  id         String        @id @default(cuid())
  businessId String
  tagId      String
  createdAt  DateTime      @default(now())
  business   businesses    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tag        business_tags @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([businessId, tagId])
  @@map("business_tag_mapping")
}

model business_attachments {
  id         String             @id @default(cuid())
  businessId String
  fileKey    String
  fileName   String
  fileSize   Int
  mimeType   String
  category   AttachmentCategory @default(DOCUMENT)
  url        String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  business   businesses         @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_attachments")
}

model business_notes {
  id         String     @id @default(cuid())
  businessId String
  authorId   String
  content    String
  isPrivate  Boolean    @default(true)
  isPinned   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  business   businesses @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author     users      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_notes")
}

model business_timeline {
  id          String     @id @default(cuid())
  businessId  String
  actorId     String?
  eventType   String
  description String
  metadata    Json?
  createdAt   DateTime   @default(now())
  business    businesses @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_timeline")
}

model divisions {
  id         String     @id @default(cuid())
  businessId String
  name       String
  code       String?
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  business   businesses @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locations  locations[]

  @@index([businessId])
  @@map("divisions")
}

model locations {
  id          String        @id @default(cuid())
  divisionId  String
  name        String
  code        String?
  address     String?
  timezone    String        @default("UTC")
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  division    divisions     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  departments departments[]

  @@index([divisionId])
  @@map("locations")
}

model departments {
  id         String    @id @default(cuid())
  locationId String
  name       String
  code       String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  location   locations @relation(fields: [locationId], references: [id], onDelete: Cascade)
  teams      teams[]

  @@index([locationId])
  @@map("departments")
}

model teams {
  id           String      @id @default(cuid())
  departmentId String
  name         String
  code         String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  department   departments @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@map("teams")
}

model subscriptions {
  id                 String             @id @default(cuid())
  tenantId           String
  planName           PlanTier           @default(TRIAL)
  status             SubscriptionStatus @default(TRIALING)
  billingEmail       String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

model audit_logs {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  entity    String
  entityId  String
  action    String
  changes   String[]
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      users?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model tenant_features {
  id         String   @id @default(cuid())
  tenantId   String
  featureKey String
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  config     Json?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

model branch {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  location  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  code      String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean     @default(true)
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees employees[]

  @@unique([tenantId, code])
  @@map("branches")
}

model roles_permissions {
  id          String    @id @default(cuid())
  tenantId    String
  roleName    String
  permissions String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleName])
  @@map("roles_permissions")
}

model users {
  id                      String                     @id @default(cuid())
  tenantId                String?
  name                    String
  email                   String                     @unique
  passwordHash            String
  role                    UserRole                   @default(CUSTOMER)
  isActive                Boolean                    @default(true)
  lastLoginAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  profileImageUrl         String?
  auditLogs               audit_logs[]
  approvedLeaves          employee_leaves[]
  employeeProfile         employees?
  notificationPreferences notification_preferences[]
  notifications           notification_recipients[]
  registerSessions        pos_register_sessions[]
  reservations            reservations[]
  businessOwnerships      business_ownership[]
  businessNotes          business_notes[]
  customerNotes          customer_notes[]
  customers              customers[]
  tenant                  Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  otpSessions             otp_sessions[]
  passwordResetTokens     password_reset_tokens[]
  refreshSessions         refresh_sessions[]

  @@index([tenantId])
  @@index([role])
}

model categories {
  id         String       @id @default(cuid())
  tenantId   String
  name       String
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menu_items menu_items[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model menu_items {
  id                    String                  @id @default(cuid())
  tenantId              String
  categoryId            String?
  name                  String
  description           String?
  price                 Decimal                 @db.Decimal(10, 2)
  imageUrl              String?
  isAvailable           Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  stationCode           String?                 @default("MAIN_KITCHEN")
  menu_item_addons      menu_item_addons[]
  menu_item_ingredients menu_item_ingredients[]
  menu_item_variants    menu_item_variants[]
  categories            categories?             @relation(fields: [categoryId], references: [id])
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order_items           order_items[]

  @@index([categoryId])
  @@index([tenantId])
  @@index([stationCode])
}

model menu_item_variants {
  id         String     @id @default(cuid())
  tenantId   String
  menuItemId String
  name       String
  priceDelta Decimal    @default(0) @db.Decimal(10, 2)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  menu_items menu_items @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([menuItemId])
}

model menu_item_addons {
  id         String     @id @default(cuid())
  tenantId   String
  menuItemId String
  name       String
  price      Decimal    @default(0) @db.Decimal(10, 2)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  menu_items menu_items @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([menuItemId])
}

model order_items {
  id         String     @id @default(cuid())
  quantity   Int
  price      Decimal    @db.Decimal(10, 2)
  notes      String?
  orderId    String
  menuItemId String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  menu_items menu_items @relation(fields: [menuItemId], references: [id])
  orders     orders     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([orderId])
}

model orders {
  id            String           @id @default(cuid())
  orderNumber   String
  customerName  String?
  customerPhone String?
  totalAmount   Decimal          @db.Decimal(10, 2)
  tenantId      String
  tableId       String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  status        OrderStatus      @default(PENDING)
  invoice       invoices?
  order_items   order_items[]
  payments      order_payments[]
  kitchen_tickets kitchen_tickets[]
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables        tables           @relation(fields: [tableId], references: [id])
  retailReturns retail_returns[]
  logisticsShipments logistics_shipments[]
  logisticsReturns   logistics_returns[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([status])
  @@index([tableId])
}

model tables {
  id           String         @id @default(cuid())
  tenantId     String
  name         String
  code         String
  capacity     Int            @default(2)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  qrCode       String?        @unique
  orders       orders[]
  reservations reservations[]
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
}

model inventory_items {
  id                    String                  @id @default(cuid())
  tenantId              String
  name                  String
  sku                   String?
  category              String?
  quantity              Decimal                 @default(0) @db.Decimal(10, 2)
  unit                  String
  lowStockLevel         Decimal                 @default(0) @db.Decimal(10, 2)
  reorderLevel          Decimal                 @default(0) @db.Decimal(10, 2)
  costPerUnit           Decimal                 @default(0) @db.Decimal(10, 2)
  supplierId            String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  tenant                Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suppliers             suppliers?              @relation(fields: [supplierId], references: [id])
  inventory_movements   inventory_movements[]
  menu_item_ingredients menu_item_ingredients[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([supplierId])
}

model menu_item_ingredients {
  id              String          @id @default(cuid())
  tenantId        String
  menuItemId      String
  inventoryItemId String
  quantity        Decimal         @db.Decimal(10, 2)
  unit            String?         @default("GRAM")
  wastagePercent  Decimal?        @default(0) @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inventory_items inventory_items @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  menu_items      menu_items      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, inventoryItemId])
  @@index([tenantId])
  @@index([menuItemId])
  @@index([inventoryItemId])
}

model inventory_movements {
  id              String          @id @default(cuid())
  tenantId        String
  inventoryItemId String
  orderId         String?
  orderItemId     String?
  type            String
  quantity        Decimal         @db.Decimal(10, 2)
  unit            String?
  beforeQuantity  Decimal?        @db.Decimal(10, 2)
  afterQuantity   Decimal?        @db.Decimal(10, 2)
  referenceType   String?
  referenceId     String?
  reason          String?
  createdBy       String?
  createdAt       DateTime        @default(now())
  inventory_items inventory_items @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([inventoryItemId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model suppliers {
  id              String            @id @default(cuid())
  tenantId        String
  name            String
  email           String?
  phone           String?
  address         String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inventory_items inventory_items[]
  purchase_orders purchase_orders[]
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model purchase_orders {
  id                   String                 @id @default(cuid())
  tenantId             String
  supplierId           String?
  status               PurchaseOrderStatus    @default(DRAFT)
  expectedDeliveryDate DateTime?
  notes                String?
  totalAmount          Decimal                @default(0) @db.Decimal(10, 2)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  purchase_order_items purchase_order_items[]
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suppliers            suppliers?             @relation(fields: [supplierId], references: [id])

  @@index([tenantId])
  @@index([supplierId])
  @@index([status])
}

model purchase_order_items {
  id              String          @id @default(cuid())
  purchaseOrderId String
  name            String
  quantity        Decimal         @db.Decimal(10, 2)
  unitPrice       Decimal         @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  purchase_orders purchase_orders @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model reservations {
  id              String            @id @default(cuid())
  tenantId        String
  tableId         String
  customerName    String
  customerPhone   String?
  guestCount      Int
  reservationAt   DateTime
  durationMinutes Int               @default(60)
  status          ReservationStatus @default(PENDING)
  notes           String?
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tables          tables            @relation(fields: [tableId], references: [id])
  users           users?            @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tableId])
  @@index([status])
  @@index([reservationAt])
}

model order_payments {
  id                String                 @id @default(cuid())
  orderId           String
  amount            Decimal                @db.Decimal(10, 2)
  paymentMethod     String                 @default("CASH")
  transactionId     String?
  status            String                 @default("SUCCESS")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  registerSessionId String?
  order             orders                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  registerSession   pos_register_sessions? @relation(fields: [registerSessionId], references: [id])

  @@index([orderId])
  @@index([registerSessionId])
}

model invoices {
  id            String   @id @default(cuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  subtotal      Decimal  @db.Decimal(10, 2)
  tax           Decimal  @db.Decimal(10, 2)
  serviceCharge Decimal  @db.Decimal(10, 2)
  discount      Decimal  @db.Decimal(10, 2)
  grandTotal    Decimal  @db.Decimal(10, 2)
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  order         orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model notifications {
  id         String                    @id @default(cuid())
  tenantId   String?
  title      String
  body       String
  type       String                    @default("INFO")
  priority   String                    @default("LOW")
  category   String                    @default("general")
  metadata   Json?
  createdAt  DateTime                  @default(now())
  history    notification_history[]
  recipients notification_recipients[]

  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@index([createdAt])
}

model notification_recipients {
  id             String                 @id @default(cuid())
  notificationId String
  userId         String
  read           Boolean                @default(false)
  archived       Boolean                @default(false)
  readAt         DateTime?
  archivedAt     DateTime?
  history        notification_history[]
  notification   notifications          @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           users                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
  @@index([read])
  @@index([archived])
}

model notification_templates {
  id            String   @id @default(cuid())
  tenantId      String?
  trigger       String   @unique
  titleTemplate String
  bodyTemplate  String
  channels      String[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([trigger])
}

model notification_preferences {
  id        String   @id @default(cuid())
  userId    String
  category  String
  channels  String[]
  updatedAt DateTime @updatedAt
  user      users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model notification_history {
  id             String                   @id @default(cuid())
  notificationId String
  recipientId    String?
  channel        String
  status         String                   @default("PENDING")
  errorMessage   String?
  attempts       Int                      @default(1)
  sentAt         DateTime                 @default(now())
  notification   notifications            @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient      notification_recipients? @relation(fields: [recipientId], references: [id])

  @@index([notificationId])
  @@index([recipientId])
  @@index([status])
}

model employees {
  id           String                @id @default(cuid())
  userId       String?               @unique
  tenantId     String
  branchId     String?
  employeeId   String
  name         String
  email        String?
  phone        String?
  photoUrl     String?
  department   String
  designation  String
  managerId    String?
  role         String                @default("STAFF")
  status       String                @default("ACTIVE")
  salary       Decimal?              @db.Decimal(10, 2)
  encryptedSalary String?
  hireDate     DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  attendance   employee_attendance[]
  documents    employee_documents[]
  leaves       employee_leaves[]
  shifts       employee_shifts[]
  branch       branch?               @relation(fields: [branchId], references: [id])
  manager      employees?            @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates employees[]           @relation("ManagerSubordinates")
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         users?                @relation(fields: [userId], references: [id])
  restShifts   rest_shifts[]
  housekeepingTasks hotel_housekeeping_tasks[]
  hcAppointments hc_appointments[]
  logisticsDriverAssignments logistics_driver_assignments[]
  logisticsRoutes logistics_routes[]

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@index([branchId])
  @@index([managerId])
}

model employee_attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime
  clockIn    DateTime
  clockOut   DateTime?
  status     String    @default("ON_TIME")
  latitude   Float?
  longitude  Float?
  qrToken    String?
  breaks     Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  employee   employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model employee_shifts {
  id         String    @id @default(cuid())
  employeeId String
  startTime  String
  endTime    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  notes      String?
  dayOfWeek  Int
  employee   employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
  @@index([employeeId])
}

model employee_leaves {
  id           String    @id @default(cuid())
  employeeId   String
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String    @default("PENDING")
  approvedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  leaveType    String
  approvedBy   users?    @relation(fields: [approvedById], references: [id])
  employee     employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([approvedById])
}

model employee_documents {
  id         String    @id @default(cuid())
  employeeId String
  name       String
  createdAt  DateTime  @default(now())
  expiryDate DateTime?
  fileUrl    String
  updatedAt  DateTime  @updatedAt
  employee   employees @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model pos_register_sessions {
  id              String                   @id @default(cuid())
  tenantId        String
  cashierId       String
  openingTime     DateTime                 @default(now())
  closingTime     DateTime?
  openingBalance  Decimal                  @db.Decimal(10, 2)
  closingBalance  Decimal?                 @db.Decimal(10, 2)
  expectedBalance Decimal?                 @db.Decimal(10, 2)
  status          String                   @default("OPEN")
  notes           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  payments        order_payments[]
  cashLogs        pos_register_cash_logs[]
  cashier         users                    @relation(fields: [cashierId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([cashierId])
}

model pos_register_cash_logs {
  id        String                @id @default(cuid())
  sessionId String
  amount    Decimal               @db.Decimal(10, 2)
  type      String
  reason    String
  createdAt DateTime              @default(now())
  session   pos_register_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model otp_sessions {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  purpose    String
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user users? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
}

model password_reset_tokens {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model refresh_sessions {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  deviceId         String?
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum PlanTier {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  SUPERVISOR
  OPERATOR
  CASHIER
  RECEPTIONIST
  CUSTOMER
  VENDOR
  SUPPLIER
  PARTNER
  AUDITOR
  SUPPORT
  DEVELOPER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BusinessStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum OwnershipRole {
  OWNER
  MANAGER
  OPERATOR
  PARTNER
}

enum RelationshipType {
  PARENT
  CHILD
  FRANCHISE
  SUPPLIER
  CUSTOMER
  VENDOR
  PARTNER
  DISTRIBUTOR
}

enum ContactType {
  PRIMARY
  BILLING
  EMERGENCY
  TECHNICAL
  OTHER
}

enum AddressType {
  HEAD_OFFICE
  BRANCH
  WAREHOUSE
  BILLING
  SHIPPING
  STORE
  OTHER
}

enum AttachmentCategory {
  IMAGE
  DOCUMENT
  CERTIFICATE
  LICENSE
  CONTRACT
  OTHER
}

enum CustomerIdentityType {
  GUEST
  REGISTERED
  LINKED_USER
  ANONYMOUS
  BUSINESS
  ORGANIZATION
}

enum CustomerLifecycleStage {
  PROSPECT
  LEAD
  REGISTERED
  VERIFIED
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
  DELETED
}

enum CustomerStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  SUSPENDED
  ARCHIVED
  CLOSED
}

enum ConsentType {
  MARKETING
  PRIVACY
  DATA_SHARING
  COOKIE
  TERMS
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum LoyaltyStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CustomerContactType {
  PRIMARY_EMAIL
  SECONDARY_EMAIL
  MOBILE_PHONE
  WORK_PHONE
  ALTERNATE
}

enum CustomerAddressType {
  HOME
  WORK
  BILLING
  SHIPPING
  LOCATION
  OTHER
}

enum CustomerRelationshipType {
  FAMILY
  ORGANIZATION
  BUSINESS
  EMERGENCY_CONTACT
  SPOUSE
  DEPENDENT
  OTHER
}

enum CustomerAttachmentCategory {
  ID_CARD
  PROOF_OF_ADDRESS
  CONTRACT
  TAX_DOCUMENT
  AVATAR
  DOCUMENT
  OTHER
}

model customers {
  id                 String                 @id @default(cuid())
  tenantId           String?
  userId             String?
  businessId         String?
  customerCode       String?
  identityType       CustomerIdentityType   @default(REGISTERED)
  lifecycleStage     CustomerLifecycleStage @default(PROSPECT)
  status             CustomerStatus         @default(ACTIVE)
  verificationStatus String                 @default("UNVERIFIED")
  externalId         String?
  externalSystem     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?

  tenant             Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               users?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  business           businesses?            @relation(fields: [businessId], references: [id], onDelete: SetNull)

  profile            customer_profiles?
  consents           customer_consents[]
  loyalty            customer_loyalty?
  contacts           customer_contacts[]
  addresses          customer_addresses[]
  sourceRelations    customer_relationships[] @relation("SourceCustomer")
  targetRelations    customer_relationships[] @relation("TargetCustomer")
  groupMappings      customer_group_mappings[]
  tagMappings        customer_tag_mappings[]
  attachments        customer_attachments[]
  notes              customer_notes[]
  preferences        customer_preferences?
  communications     customer_communications?
  commHistory        customer_communication_history[]
  transactions       transactions_registry[]
  universalOrders    universal_orders[]
  paymentTransactions payment_transactions[]
  wallets            customer_wallets[]
  paymentTokens      payment_tokens[]
  billingSchedules   billing_schedules[]
  verifications      customer_verifications[]
  sourceMerges       customer_merge_history[] @relation("SourceCustomerMerge")
  targetMerges       customer_merge_history[] @relation("TargetCustomerMerge")
  timeline           customer_timeline[]
  crmLeads           crm_leads[]
  crmOpportunities   crm_opportunities[]
  crmCases           crm_cases[]
  crmInteractions    crm_interactions[]
  crmConsents        crm_consents[]
  crmLoyalty         crm_loyalty?
  crmTickets         crm_tickets[]
  crmFeedbacks       crm_feedbacks[]
  crmRelationshipsFrom crm_relationships[] @relation("CrmFromCustomer")
  crmRelationshipsTo   crm_relationships[] @relation("CrmToCustomer")
  restReservations     rest_reservations[]
  custFavorites        cust_favorites[]
  custReviews          cust_reviews[]
  custDevices          cust_devices[]
  custCarts            cust_carts[]
  custConsent          cust_consent_settings?
  custWallet           cust_wallet_ledger?
  aiMemories           ai_memories[]
  hotelBookings        hotel_bookings[]
  hcPatientProfile     hc_patient_profiles?
  rewardRedemptions    customer_reward_redemptions[]
  referrerReferrals    customer_referrals[] @relation("ReferrerCustomer")
  referredReferrals    customer_referrals[] @relation("ReferredCustomer")

  @@index([tenantId])
  @@index([userId])
  @@index([businessId])
  @@index([customerCode])
  @@index([status])
  @@index([lifecycleStage])
  @@map("customers")
}

model customer_profiles {
  id            String    @id @default(cuid())
  customerId    String    @unique
  firstName     String?
  lastName      String?
  displayName   String?
  preferredName String?
  title         String?
  dateOfBirth   DateTime?
  gender        String?
  avatarUrl     String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      customers @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model customer_consents {
  id         String      @id @default(cuid())
  customerId String
  type       ConsentType
  isGranted  Boolean     @default(true)
  version    String      @default("1.0")
  source     String      @default("WEB")
  actorId    String?
  grantedAt  DateTime    @default(now())
  revokedAt  DateTime?
  customer   customers   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_consents")
}

model customer_loyalty {
  id            String        @id @default(cuid())
  customerId    String        @unique
  tier          LoyaltyTier   @default(BRONZE)
  status        LoyaltyStatus @default(ACTIVE)
  pointsBalance Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  customer      customers     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_loyalty")
}

model customer_rewards {
  id            String                       @id @default(cuid())
  tenantId      String?
  name          String
  description   String?
  pointsCost    Int
  discountValue Decimal                      @db.Decimal(10, 2)
  discountType  String                       @default("FIXED")
  minTier       String                       @default("NEW")
  isActive      Boolean                      @default(true)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  redemptions   customer_reward_redemptions[]

  @@index([tenantId])
  @@map("customer_rewards")
}

model customer_reward_redemptions {
  id          String           @id @default(cuid())
  tenantId    String?
  customerId  String
  rewardId    String
  pointsSpent Int
  couponCode  String           @unique
  status      String           @default("ACTIVE")
  redeemedAt  DateTime         @default(now())
  usedAt      DateTime?
  customer    customers        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reward      customer_rewards @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([rewardId])
  @@map("customer_reward_redemptions")
}

model customer_offers {
  id                 String    @id @default(cuid())
  tenantId           String?
  code               String
  title              String
  description        String?
  discountType       String    @default("PERCENTAGE")
  discountValue      Decimal   @db.Decimal(10, 2)
  minPurchaseAmount Decimal   @default(0) @db.Decimal(10, 2)
  maxDiscountAmount  Decimal?  @db.Decimal(10, 2)
  targetTier         String?
  targetSegment      String?
  validFrom          DateTime?
  validUntil         DateTime?
  usageLimit         Int?
  usedCount          Int       @default(0)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("customer_offers")
}

model customer_referrals {
  id                 String    @id @default(cuid())
  tenantId           String?
  referrerCustomerId String
  referredCustomerId String?
  referralCode       String
  status             String    @default("PENDING")
  rewardPoints       Int       @default(100)
  createdAt          DateTime  @default(now())
  completedAt        DateTime?
  referrer           customers @relation("ReferrerCustomer", fields: [referrerCustomerId], references: [id], onDelete: Cascade)
  referred           customers? @relation("ReferredCustomer", fields: [referredCustomerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([referrerCustomerId])
  @@index([referredCustomerId])
  @@index([referralCode])
  @@map("customer_referrals")
}

model customer_contacts {
  id         String              @id @default(cuid())
  customerId String
  type       CustomerContactType @default(PRIMARY_EMAIL)
  value      String
  isPrimary  Boolean             @default(false)
  isVerified Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?
  customer   customers           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

model customer_addresses {
  id         String              @id @default(cuid())
  customerId String
  type       CustomerAddressType @default(HOME)
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String
  latitude   Float?
  longitude  Float?
  timezone   String              @default("UTC")
  isPrimary  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?
  customer   customers           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model customer_relationships {
  id                   String                   @id @default(cuid())
  sourceCustomerId     String
  targetCustomerId     String?
  targetBusinessId     String?
  targetOrganizationId String?
  type                 CustomerRelationshipType
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?
  sourceCustomer       customers                @relation("SourceCustomer", fields: [sourceCustomerId], references: [id], onDelete: Cascade)
  targetCustomer       customers?               @relation("TargetCustomer", fields: [targetCustomerId], references: [id], onDelete: Cascade)

  @@index([sourceCustomerId])
  @@index([targetCustomerId])
  @@map("customer_relationships")
}

model customer_groups {
  id          String                  @id @default(cuid())
  tenantId    String?
  name        String
  slug        String                  @unique
  description String?
  color       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  deletedAt   DateTime?
  mappings    customer_group_mappings[]

  @@map("customer_groups")
}

model customer_group_mappings {
  id         String          @id @default(cuid())
  customerId String
  groupId    String
  assignedAt DateTime        @default(now())
  customer   customers       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  group      customer_groups @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([customerId, groupId])
  @@map("customer_group_mappings")
}

model customer_tags {
  id        String                @id @default(cuid())
  tenantId  String?
  name      String                @unique
  color     String?
  createdAt DateTime              @default(now())
  mappings  customer_tag_mappings[]

  @@map("customer_tags")
}

model customer_tag_mappings {
  id         String        @id @default(cuid())
  customerId String
  tagId      String
  assignedAt DateTime      @default(now())
  customer   customers     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag        customer_tags @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@map("customer_tag_mappings")
}

model customer_attachments {
  id         String                     @id @default(cuid())
  customerId String
  fileKey    String
  fileName   String
  fileSize   Int
  mimeType   String
  category   CustomerAttachmentCategory @default(DOCUMENT)
  url        String
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  deletedAt  DateTime?
  customer   customers                  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_attachments")
}

