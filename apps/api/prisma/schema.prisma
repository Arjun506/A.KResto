model products {
  id               String                @id @default(cuid())
  tenantId         String?
  businessId       String?
  sku              String
  barcode          String?
  name             String
  slug             String                @unique
  description      String?
  shortDescription String?
  identityType     ProductIdentityType   @default(PHYSICAL)
  lifecycleStage   ProductLifecycleStage @default(ACTIVE)
  status           ProductStatus         @default(ACTIVE)
  publishingStatus PublishingStatus      @default(PUBLISHED)
  brand            String?
  isTaxable        Boolean               @default(true)
  taxClassId       String?
  primaryUomId     String?

  // Inventory Readiness Toggles
  trackInventory   Boolean               @default(false)
  isBatchManaged   Boolean               @default(false)
  isSerialized     Boolean               @default(false)
  isExpiryManaged  Boolean               @default(false)
  isStockManaged   Boolean               @default(false)

  // SEO Baseline
  seoTitle         String?
  metaDescription  String?
  metaKeywords     String?
  canonicalUrl     String?

  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  tenant           Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  business         businesses?           @relation(fields: [businessId], references: [id], onDelete: SetNull)

  versions         product_versions[]
  translations     product_translations[]
  sourceRelations  product_relationships[] @relation("SourceProduct")
  targetRelations  product_relationships[] @relation("TargetProduct")
  digitalAssets    product_digital_assets[]
  compliance       product_compliance[]
  categoryMappings product_category_mappings[]
  attributeValues  product_attribute_values[]
  options          product_options[]
  variants         product_variants[]
  parentBundles    product_bundles[]     @relation("ParentProduct")
  componentBundles product_bundles[]     @relation("ComponentProduct")
  media            product_media[]
  prices           product_prices[]
  suppliers        product_suppliers[]
  availabilities   product_availability[]
  tagMappings      product_tag_mappings[]
  timeline         product_timeline[]
  retailVariants   retail_product_variants[]
  retailStockBatches retail_stock_batches[]

  @@index([tenantId])
  @@index([businessId])
  @@index([sku])
  @@index([status])
  @@index([publishingStatus])
  @@map("products")
}

model product_versions {
  id             String    @id @default(cuid())
  productId      String
  versionNumber  Int
  snapshot       Json
  status         String    @default("PUBLISHED")
  scheduledFor   DateTime?
  publishedAt    DateTime?
  createdBy      String?
