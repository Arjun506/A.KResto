# Environment Configuration Template

## Application
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

## Database
DATABASE_URL=postgresql://a3_resto:a3_resto_password@localhost:5432/a3_resto
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

## Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

## JWT Authentication
JWT_SECRET=$(openssl rand -base64 32)
JWT_EXPIRATION=24h

## Email Service (SendGrid)
SENDGRID_API_KEY=SG.your_api_key_here
SENDER_EMAIL=noreply@a3resto.com

## SMS Service (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

## AI Integration (OpenAI)
OPENAI_API_KEY=sk-your_key_here
OPENAI_MODEL=gpt-4-turbo

## Payment Processing (Stripe)
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

## Error Monitoring (Sentry)
SENTRY_DSN=https://your_key@sentry.io/123456

## Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=https://your_key@sentry.io/123456

# Instructions for generating secrets:
# JWT_SECRET: openssl rand -base64 32
# SENDGRID_API_KEY: Get from https://sendgrid.com/
# TWILIO_*: Get from https://www.twilio.com/
# OPENAI_API_KEY: Get from https://platform.openai.com/
# STRIPE_*: Get from https://stripe.com/
# SENTRY_DSN: Get from https://sentry.io/
